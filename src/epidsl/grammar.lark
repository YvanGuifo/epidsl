// EpiDSL grammar (LALR). Whitespace and newlines are insignificant;
// statements are introduced by keywords, with an optional trailing ";".

start: (model | compose)+

model: "model" NAME "{" (_statement ";"?)* "}"

_statement: compartments | parameter | rate | flow | semantics | observe | network_decl | attribute_decl

compartments: "compartment" compartment ("," compartment)*
compartment: NAME ["=" signed]

parameter: "parameter" NAME "=" signed [prior] [UNIT]
prior: "prior" NAME "(" signed "," signed ")"
rate: "rate" NAME "=" signed [UNIT]

flow: "flow" [NAME] ARROW [NAME] ":" _expr

network_decl: "network" NAME "(" [net_param ("," net_param)*] ")"
net_param: NAME "=" signed

attribute_decl: "attribute" NAME "~" "categorical" "(" attr_category ("," attr_category)* ")"
attr_category: NAME "=" signed

observe: "observe" NAME "=" _expr [noise] [delay_clause]
noise: "~" NAME "(" [noise_arg ("," noise_arg)*] ")"
noise_arg: signed | NAME
delay_clause: "delay" "(" signed ")"

semantics: "semantics" ":" "[" NAME ("," NAME)* "]"

compose: "compose" NAME "{" (_compose_statement ";"?)* "}"

_compose_statement: models | sync | stratified_parameter | stratified_rate | enter | observe
    | parameter | rate | migrate

migrate: "migrate" NAME ("," NAME)* ":" NAME

models: "models" ":" "[" NAME ("," NAME)* "]"
sync: "sync" move ("," move)+ ":" _expr
move: NAME ARROW NAME

stratified_parameter: "parameter" NAME "by" by_models "=" "{" stratum ("," stratum)* "}" [prior] [UNIT]
stratified_rate: "rate" NAME "by" by_models "=" "{" stratum ("," stratum)* "}" [UNIT]
by_models: NAME
         | NAME "," NAME
stratum: NAME ":" signed
       | NAME "," NAME ":" signed

enter: "enter" NAME "at" NAME

signed: NUMBER        -> positive
      | "-" NUMBER    -> negative

_expr: sum
?sum: product
    | sum "+" product   -> add
    | sum "-" product   -> sub
?product: unary
    | product "*" unary -> mul
    | product "/" unary -> div
?unary: "-" unary       -> neg
    | power
?power: atom
    | atom "^" unary    -> pow
?atom: NUMBER           -> number
    | NAME              -> symbol
    | NAME "(" [_expr ("," _expr)*] ")" -> call
    | "incidence" "(" [NAME] ARROW [NAME] ")" -> incidence
    | "(" _expr ")"

ARROW: "->"
NAME: /[A-Za-z_][A-Za-z0-9_]*/
NUMBER: /(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?/
UNIT: /\[[^\]\n]*\]/

%ignore /\s+/
%ignore /--[^\n]*/
%ignore /\/\*(.|\n)*?\*\//
