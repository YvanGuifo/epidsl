-- SIR with temporary lockdown using pulse(t, t0, t1)
-- Lockdown is fully in effect during [day 20, day 50), then lifted.
-- R0_outside = 0.0003 * 1000 / 0.1 = 3.0  (epidemic grows without intervention)
-- R0_during  = 0.00003 * 1000 / 0.1 = 0.3  (epidemic declines during lockdown)

model SIR {
    semantics: [ODE, Gillespie, TauLeap]
    compartment S = 990, I = 10, R = 0
    rate beta  = 0.0003    [1/day]
    rate phi   = 0.9       [1]
    rate gamma = 0.1       [1/day]
    flow S -> I : beta * (1 - phi * pulse(t, 20, 50)) * S * I
    flow I -> R : gamma * I
}
