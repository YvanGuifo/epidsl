-- SIR with time-triggered lockdown using ifelse(t - t_lock, beta_lo, beta_hi)
-- Before t_lock = 30 days: high transmission (no intervention).
-- After  t_lock = 30 days: reduced transmission (lockdown in place).
-- ifelse returns beta_lo when t > 30, beta_hi otherwise.

model SIR {
    semantics: [ODE, Gillespie, TauLeap]
    compartment S = 990, I = 10, R = 0
    rate t_lock  = 30     [day]
    rate beta_hi = 0.0003 [1/day]
    rate beta_lo = 0.0001 [1/day]
    rate gamma   = 0.1    [1/day]
    flow S -> I : ifelse(t - t_lock, beta_lo, beta_hi) * S * I
    flow I -> R : gamma * I
}
