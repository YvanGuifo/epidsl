-- Metapopulation SIR on three cities (Paris, Lyon, Marseille).
--
-- The model is the Kronecker product of a base SIR and a "Patch" model whose
-- compartments name the cities.  Initial populations are proportional to the
-- patch weights (here equal: 1/3 each).
--
-- The 'migrate' statement generates inter-city flows for the listed
-- compartments (S, I, R) according to the travel matrix.  Rows are the origin
-- city, columns are the destination.  Off-diagonal entry (i, j) is the per-
-- capita daily rate at which residents of city i travel to city j.

model SIR {
    semantics: [ODE, Gillespie, TauLeap]
    compartment S = 9900, I = 100, R = 0

    rate beta  = 0.00005 [1/day]
    rate gamma = 0.1     [1/day]

    flow S -> I : beta * S * I
    flow I -> R : gamma * I

    observe cases      = incidence(S -> I)
    observe prevalence = I
}

-- City weights sum to N = 10 000.  The product initial conditions distribute
-- the SIR population proportionally: 50 % in Paris, 30 % in Lyon, 20 % in Marseille.
model City {
    semantics: [ODE, Gillespie, TauLeap]
    compartment Paris = 5000, Lyon = 3000, Marseille = 2000
}

compose MetaSIR {
    models: [SIR, City]

    -- Travel rates [1/day].  Zero on the diagonal; moderate inter-city travel.
    rate travel by City, City = {
        Paris,     Paris:     0,
        Paris,     Lyon:      0.005,
        Paris,     Marseille: 0.002,
        Lyon,      Paris:     0.005,
        Lyon,      Lyon:      0,
        Lyon,      Marseille: 0.003,
        Marseille, Paris:     0.002,
        Marseille, Lyon:      0.003,
        Marseille, Marseille: 0
    } [1/day]

    -- S, I and R all travel (infection status is unaffected by travel).
    migrate S, I, R : travel
}
