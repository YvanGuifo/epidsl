-- SIR with smooth lockdown using smoothstep(t, t0, t1)
-- Lockdown effectiveness increases smoothly over [day 10, day 30]: no abrupt
-- change of rate at the transition boundaries (C1 continuous).
--
-- R0_before = 0.0003 * 1000 / 0.1 = 3.0
-- R0_after  = 0.0003 * (1 - 0.8) * 1000 / 0.1 = 0.6

model SIR {
    semantics: [ODE, Gillespie, TauLeap]
    compartment S = 990, I = 10, R = 0
    rate beta  = 0.0003  [1/day]
    rate phi   = 0.8     [1]
    rate gamma = 0.1     [1/day]
    flow S -> I : beta * (1 - phi * smoothstep(t, 10, 30)) * S * I
    flow I -> R : gamma * I
}
