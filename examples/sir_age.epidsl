-- Stratifying an epidemic model by age through composition.
-- AgeSIR has one compartment per (status, age group) pair: S_young, S_old, ...

model SIR {
    compartment S = 990, I = 10, R = 0

    parameter beta = 0.3 [1/day]
    rate gamma = 0.1 [1/day]

    flow S -> I : beta * S * I / N
    flow I -> R : gamma * I
}

model Age {
    compartment young = 300, old = 700

    rate aging = 0.002 [1/day]

    flow young -> old : aging * young
}

compose AgeSIR {
    models: [SIR, Age]
}
