-- An age-structured epidemic in an open population.
-- Susceptibility and reporting differ by age group, births enter the young group,
-- and the reported cases of each group can be used to estimate each group's beta.

model Epidemic {
    compartment S = 9990, I = 10, R = 0

    parameter beta = 0.5 prior uniform(0.05, 1) [1/day]
    rate gamma = 0.1 [1/day]
    rate mu = 0.0005 [1/day]       -- per-capita birth and death rate

    flow -> S : mu * N
    flow S -> I : beta * S * I / N
    flow I -> R : gamma * I
    flow S -> : mu * S
    flow I -> : mu * I
    flow R -> : mu * R
}

model Age {
    compartment young = 3000, old = 7000

    rate aging = 0.001 [1/day]

    flow young -> old : aging * young
}

compose AgeStructured {
    models: [Epidemic, Age]

    -- One value per age group: beta_young and beta_old, each with beta's prior.
    parameter beta by Age = { young: 0.6, old: 0.3 }

    -- Fraction of infections reported in each age group.
    rate rho_young = 0.8 [1]
    rate rho_old = 0.4 [1]

    -- Newborns join the young group.
    enter Age at young

    -- Reported new infections per period, by age group.
    observe cases_young = rho_young * incidence(S_young -> I_young)
    observe cases_old = rho_old * incidence(S_old -> I_old)
}
